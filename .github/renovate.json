{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "automerge": true,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/test\\.yaml$/"],
      "matchStrings": [
        "repo: (?<depName>[^\\s]+)\\s+ref: (?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Update the projects that CI indexes once a quarter, in one PR.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/test.yaml"],
      "schedule": ["* * 1 */3 *"],
      "groupName": "index test projects"
    },
    {
      "description": "Test sub-modules must stay in sync with the root go.mod because the Nix checkPhase resolves modules offline from the root go.sum. Indirect updates are disabled by default, so enable them here, but only for modules the root go.mod requires directly: Renovate doesn't update the root's indirect golang.org/x/sync, so bumping it only in a sub-module breaks the build.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchFileNames": ["internal/testdata/**/go.mod"],
      "matchPackageNames": ["golang.org/x/mod"],
      "enabled": true
    },
    {
      "description": "Update the golang.org/x modules together, since golang.org/x/tools requires recent versions of the others.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "groupName": "golang.org/x",
      "groupSlug": "golang-x"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
