{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/test\\.yaml$"],
      "matchStrings": [
        "repo: (?<depName>[^\\s]+)\\s+ref: (?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/test.yaml"],
      "schedule": ["* * 1 */3 *"]
    },
    {
      "description": "Test sub-modules must stay in sync with the root go.mod because the Nix checkPhase resolves modules offline from the root go.sum. Indirect updates are disabled by default, so enable them here.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchFileNames": ["internal/testdata/**/go.mod"],
      "enabled": true
    }
  ]
}
